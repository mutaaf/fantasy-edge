#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    # A net: its cord mask (uv0, the model's own repeats), brightened by
    # CordGain so a mipped, distant net still averages to a readable mesh, times
    # an opacity that is FaceOpacity where the net faces the eye - behind the
    # goal, the view that matters most - and falls toward GrazingOpacity as the
    # net turns edge-on. Unlit, like fine cord under floodlights.
    #
    # Parameters (tokens: shaderGraph.materials.netFresnel; the two opacities
    # come from visual.sideline.net):
    #   Mask            (asset)   cord coverage, grey
    #   Color           (color3)  cord colour
    #   FaceOpacity     (float)   opacity seen face-on (the minimum a net keeps)
    #   GrazingOpacity  (float)   opacity seen edge-on
    #   Power           (float)   how quickly it moves from face-on to grazing
    #   CordGain        (float)   multiplies the mask before clamping to 1
    def Material "NetFresnel"
    {
        asset inputs:Mask = @./textures/placeholder_net.png@
        color3f inputs:Color = (0.8, 0.8, 0.78)
        float inputs:FaceOpacity = 0.45
        float inputs:GrazingOpacity = 0.12
        float inputs:Power = 1.6
        float inputs:CordGain = 2.5

        token outputs:mtlx:surface.connect = </Root/NetFresnel/Surface.outputs:out>

        def Shader "Surface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/NetFresnel.inputs:Color>
            float inputs:opacity.connect = </Root/NetFresnel/Final.outputs:out>
            bool inputs:applyPostProcessToneMap = 1
            bool inputs:hasPremultipliedAlpha = 0
            token outputs:out
        }

        def Shader "Cord"
        {
            uniform token info:id = "ND_image_float"
            asset inputs:file.connect = </Root/NetFresnel.inputs:Mask>
            float outputs:out
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "View"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            float3 outputs:out
        }

        def Shader "Facing"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/NetFresnel/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/NetFresnel/View.outputs:out>
            float outputs:out
        }

        def Shader "Abs"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/NetFresnel/Facing.outputs:out>
            float outputs:out
        }

        def Shader "Edge"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </Root/NetFresnel/Abs.outputs:out>
            float outputs:out
        }

        def Shader "Falloff"
        {
            uniform token info:id = "ND_power_float"
            float inputs:in1.connect = </Root/NetFresnel/Edge.outputs:out>
            float inputs:in2.connect = </Root/NetFresnel.inputs:Power>
            float outputs:out
        }

        def Shader "Lifted"
        {
            uniform token info:id = "ND_mix_float"
            float inputs:fg.connect = </Root/NetFresnel.inputs:GrazingOpacity>
            float inputs:bg.connect = </Root/NetFresnel.inputs:FaceOpacity>
            float inputs:mix.connect = </Root/NetFresnel/Falloff.outputs:out>
            float outputs:out
        }

        def Shader "CordGained"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/NetFresnel/Cord.outputs:out>
            float inputs:in2.connect = </Root/NetFresnel.inputs:CordGain>
            float outputs:out
        }

        def Shader "CordClamped"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/NetFresnel/CordGained.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }

        def Shader "Final"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/NetFresnel/Lifted.outputs:out>
            float inputs:in2.connect = </Root/NetFresnel/CordClamped.outputs:out>
            float outputs:out
        }
    }

    def Sphere "Preview"
    {
        rel material:binding = </Root/NetFresnel>
        double radius = 0.1
    }
}
