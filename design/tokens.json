{
  "version": 1,
  "about": "The one source for stadium and tabletop colour and motion. fantasyedge/scene.py embeds it in every scene as `palette`, tools/make_tokens.py writes fantasyedge/templates/tokens.css from it, and the visionOS app bundles this file unchanged. Edit here, never in a copy.",
  "chip": {
    "about": "A team colour is kept as its hue and solved into one relative-luminance band, so white text on any club's chip clears 4.5:1. The band and rule match Theme.chipFill.",
    "luminance": 0.159,
    "maxSaturation": 0.92,
    "neutralBelow": 0.12,
    "clashDegrees": 16,
    "text": "#FFFFFF"
  },
  "color": {
    "ink": "#F7F6F2",
    "ink.secondary": "#F7F6F2BD",
    "plate": "#121417E0",
    "fill.live": "#237A04",
    "fill.redZone": "#DF0B0B",
    "fill.score": "#8B7300",
    "turf.a": "#1E6A34",
    "turf.b": "#237A3C",
    "turf.surround": "#17401F",
    "turf.tabletopA": "#0E3A1F",
    "turf.tabletopB": "#124726",
    "line.yard": "#FFFFFF",
    "laser.scrimmage": "#A6D0FF",
    "laser.lineToGain": "#FFD400",
    "arc.run": "#9FD8FF",
    "arc.pass": "#FFFFFF",
    "arc.incomplete": "#FFFFFF",
    "arc.loss": "#FFBABA",
    "arc.score": "#FFD400",
    "arc.kick": "#E8D9A8",
    "arc.turnover": "#FFBABA",
    "arc.penalty": "#FFD400",
    "beacon": "#BFE3FF",
    "beacon.score": "#FFF3B0",
    "bowl.lower": "#302722",
    "bowl.upper": "#261F1C",
    "bowl.concourse": "#15110F",
    "crowd.neutral": "#F4F1EA",
    "crowd.dark": "#2A2A2A",
    "rim.light": "#FFF8E6",
    "sky.top": "#03050A",
    "sky.horizon": "#1A2436"
  },
  "arc": {
    "about": "Apex heights in yards. d is the yards the ball travelled along the field. A pass peaks at 3 + 0.35d, a run at 0.8 + 0.12d.",
    "shape": {
      "run": {"apexBase": 0.8, "apexPerYard": 0.12},
      "pass": {"apexBase": 3.0, "apexPerYard": 0.35},
      "kick": {"apexBase": 8.0, "apexPerYard": 0.25},
      "flat": {"apexBase": 0.0, "apexPerYard": 0.0}
    },
    "dash": {"incomplete": [1.2, 0.9]},
    "laneSpread": 0.17,
    "seconds": {
      "run": {"base": 0.9, "perYard": 0.03},
      "pass": {"base": 1.2, "perYard": 0.025},
      "incomplete": {"base": 1.2, "perYard": 0.0},
      "loss": {"base": 1.0, "perYard": 0.0},
      "kick": {"base": 2.2, "perYard": 0.0},
      "turnover": {"base": 1.6, "perYard": 0.02},
      "penalty": {"base": 0.6, "perYard": 0.0}
    }
  },
  "motion": {
    "about": "Real-time play durations are clamped to [minSeconds, maxSeconds]. A replay faster than referenceSpeed divides them by speed / referenceSpeed, never below floorSeconds, so a play finishes before the next snap arrives.",
    "minSeconds": 0.6,
    "maxSeconds": 2.5,
    "referenceSpeed": 20,
    "floorSeconds": 0.2,
    "sectionDim": 0.28,
    "reduceMotion": "jump"
  }
}
