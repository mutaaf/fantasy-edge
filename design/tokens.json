{
  "version": 1,
  "about": "The one source for stadium and tabletop colour and motion. fantasyedge/scene.py embeds it in every scene as `palette`, tools/make_tokens.py writes fantasyedge/templates/tokens.css from it, and the visionOS app bundles this file unchanged. Edit here, never in a copy.",
  "chip": {
    "about": "A team colour is kept as its hue and solved into one relative-luminance band, so white text on any club's chip clears 4.5:1. The band and rule match Theme.chipFill.",
    "luminance": 0.159,
    "maxSaturation": 0.92,
    "neutralBelow": 0.12,
    "clashDegrees": 16,
    "text": "#FFFFFF"
  },
  "color": {
    "ink": "#F7F6F2",
    "ink.secondary": "#F7F6F2BD",
    "plate": "#121417E0",
    "fill.live": "#237A04",
    "fill.redZone": "#DF0B0B",
    "fill.score": "#8B7300",
    "turf.a": "#1E6A34",
    "turf.b": "#237A3C",
    "turf.surround": "#17401F",
    "turf.tabletopA": "#0E3A1F",
    "turf.tabletopB": "#124726",
    "line.yard": "#FFFFFF",
    "laser.scrimmage": "#A6D0FF",
    "laser.lineToGain": "#FFD400",
    "arc.run": "#9FD8FF",
    "arc.pass": "#FFFFFF",
    "arc.incomplete": "#FFFFFF",
    "arc.loss": "#FFBABA",
    "arc.score": "#FFD400",
    "arc.kick": "#E8D9A8",
    "arc.turnover": "#FFBABA",
    "arc.penalty": "#FFD400",
    "beacon": "#BFE3FF",
    "beacon.score": "#FFF3B0",
    "bowl.lower": "#302722",
    "bowl.upper": "#261F1C",
    "bowl.concourse": "#15110F",
    "crowd.neutral": "#F4F1EA",
    "crowd.dark": "#2A2A2A",
    "rim.light": "#FFF8E6",
    "sky.top": "#03050A",
    "sky.horizon": "#1A2436",
    "prop.goalpost": "#F2C21B",
    "prop.pylon": "#FF6A13",
    "prop.bench": "#23272E",
    "prop.chain": "#FF6A13",
    "board.base": "#07090D",
    "ribbon.base": "#05060A",
    "ribbon.text": "#F7F6F2",
    "pressbox.glass": "#FFD7A1",
    "baseplate": "#101216",
    "baseplate.rim": "#FFE9C2"
  },
  "look": {
    "about": "Visual-only parameters: how the stadium is lit, textured and animated. Nothing here changes where anything is. Asset paths are relative to assets/src, which every client bundles unchanged.",
    "assets": {
      "turfAlbedo": "textures/turf_albedo.png",
      "turfNormal": "textures/turf_normal.png",
      "turfRoughness": "textures/turf_roughness.png",
      "paint": "textures/paint_mask.png",
      "glow": "textures/glow.png",
      "beam": "textures/beam.png",
      "trail": "textures/trail.png",
      "haze": "textures/haze.png",
      "lampFace": "textures/lamp_face.png",
      "seats": "textures/seats.png",
      "concrete": "textures/concrete.png",
      "crowd": "textures/crowd_atlas.png",
      "sky": "textures/sky_night.png",
      "probe": "env/stadium_night.hdr",
      "football": "textures/football.png",
      "crowdBed": "audio/crowd_bed.wav",
      "roar": "audio/roar.wav",
      "groan": "audio/groan.wav",
      "chime": "audio/chime.wav"
    },
    "turf": {"tileYards": 4.0, "stripeTint": ["#FFFFFF", "#C9D8C0"], "stripeRoughness": [0.86, 0.74],
             "paintOpacity": 0.9, "endZonePaintOpacity": 0.82},
    "light": {"probeIntensity": 1.6, "floodCount": 4, "floodIntensity": 180000, "floodAngle": [28, 44],
              "shadowCasters": 1, "glowYards": [14, 7], "glowOpacity": 0.55, "hazeLength": 70, "hazeOpacity": 0.05},
    "crowd": {"stadiumSeatsPerRow": 520, "tabletopSeatsPerRow": 150, "fill": 0.86, "fanYards": [0.55, 1.0],
              "tabletopFanYards": [1.4, 2.6], "slices": 20, "bob": 0.05, "surgeBob": 0.35, "waveSeconds": 9.0,
              "dim": 0.35, "bright": 1.35},
    "trail": {"stadiumCore": 0.11, "tabletopCore": 0.55, "haloScale": 2.4, "haloOpacity": 0.16,
              "ghostOpacity": 0.38, "nearYards": 30.0},
    "ball": {"stadiumScale": 2.6, "tabletopScale": 7.0, "spinPerSecond": 3.2},
    "beacon": {"stadiumWidth": 1.2, "tabletopWidth": 2.8, "opacity": 0.55},
    "ribbon": {"heightPixels": 96, "segmentYards": 36},
    "moment": {"seconds": 6.0, "strobeHz": 3.0, "fireworks": 3, "particlesPerBurst": 900},
    "audio": {"bedGain": -14, "roarGain": -4, "groanGain": -10, "chimeGain": -12, "bedEmitters": 4}
  },
  "arc": {
    "about": "Apex heights in yards. d is the yards the ball travelled along the field. A pass peaks at 3 + 0.35d, a run at 0.8 + 0.12d.",
    "shape": {
      "run": {"apexBase": 0.8, "apexPerYard": 0.12},
      "pass": {"apexBase": 3.0, "apexPerYard": 0.35},
      "kick": {"apexBase": 8.0, "apexPerYard": 0.25},
      "flat": {"apexBase": 0.0, "apexPerYard": 0.0}
    },
    "dash": {"incomplete": [1.2, 0.9]},
    "laneSpread": 0.17,
    "seconds": {
      "run": {"base": 0.9, "perYard": 0.03},
      "pass": {"base": 1.2, "perYard": 0.025},
      "incomplete": {"base": 1.2, "perYard": 0.0},
      "loss": {"base": 1.0, "perYard": 0.0},
      "kick": {"base": 2.2, "perYard": 0.0},
      "turnover": {"base": 1.6, "perYard": 0.02},
      "penalty": {"base": 0.6, "perYard": 0.0}
    }
  },
  "motion": {
    "about": "Real-time play durations are clamped to [minSeconds, maxSeconds]. A replay faster than referenceSpeed divides them by speed / referenceSpeed, never below floorSeconds, so a play finishes before the next snap arrives.",
    "minSeconds": 0.6,
    "maxSeconds": 2.5,
    "referenceSpeed": 20,
    "floorSeconds": 0.2,
    "sectionDim": 0.28,
    "reduceMotion": "jump"
  }
}
