  "motion": {
    "about": "Real-time play durations are clamped to [minSeconds, maxSeconds]. A replay faster than referenceSpeed divides them by speed / referenceSpeed, never below floorSeconds, so a play finishes before the next snap arrives.",
    "minSeconds": 0.6,
    "maxSeconds": 2.5,
    "referenceSpeed": 20,
    "floorSeconds": 0.2,
    "sectionDim": 0.28,
    "momentSeconds": 6.0,
    "reduceMotion": "jump",
    "flightEase": 1.6
  },
  "visual": {
    "about": "Visual-only parameters, one section per stadium actor (docs/ART_BIBLE.md). Nothing here changes where anything is. Asset paths are relative to assets/: generated/<actor>/ holds what tools/make_assets.py writes, actors/<actor>/ holds a specialist's authored assets. A section may name another actor's file; models are .usdz for Apple with a .glb sibling for web and Android.",
    "experience": {
      "assets": {},
      "camera": {
        "about": "The wearer's eyes above the floor of the space, and how long a seat change fades.",
        "eyeMeters": 1.2,
        "seatFadeSeconds": 0.35
      },
      "baseplate": {
        "marginScale": 1.03,
        "thicknessMeters": 0.014,
        "rimOpacity": 0.6,
        "rimRadiusYards": 0.9,
        "bevelYards": 2.4,
        "edgeOpacity": 0.55,
        "groundingShadow": true
      },
      "tabletop": {
        "about": "The table model is an architect's cutaway: the stands on the near (home) sideline are left out between these fractions of a half turn, so the wearer looks into the bowl.",
        "cutaway": {
          "side": "home",
          "from": 0.12,
          "to": 0.88
        },
        "minScale": 0.6,
        "maxScale": 1.0,
        "closerTiltDegrees": 16.0,
        "closerSeconds": 0.6
      },
      "models": {},
      "arrival": {
        "about": "Tabletop to seat. A gate of stadium light opens over the table and grows while the tabletop dims, then the space opens on the Crown dial. The world never moves the wearer's head. Reduce motion: no gate, the space opens at once.",
        "gateSeconds": 1.4,
        "gateRadiusYards": 58.0,
        "gateHeightYards": 14.0,
        "gateOpacity": 0.8,
        "tabletopDim": 0.35,
        "crownHintSeconds": 6.0,
        "crownHintOnce": true,
        "swellLeadSeconds": 0.8
      },
      "layout": {
        "about": "Every panel in the stadium as yaw (degrees, + right), flat distance (m) and height above the eye (m, - below). From a lower-bowl seat the field of play sits about 9-30 degrees below the eye, so side panels sit low and peripheral, the controls lowest, the scorebug above the far stands. tests/test_experience.py holds each slot inside maxSideDegrees and maxBelowDegrees.",
        "maxSideDegrees": 30.0,
        "maxBelowDegrees": 33.0,
        "slots": {
          "scorebug": {
            "yaw": 0.0,
            "distance": 1.8,
            "height": 0.5
          },
          "status": {
            "yaw": 0.0,
            "distance": 2.0,
            "height": 0.05
          },
          "drive": {
            "yaw": -30.0,
            "distance": 1.15,
            "height": -0.56
          },
          "trailing": {
            "yaw": 30.0,
            "distance": 1.15,
            "height": -0.56
          },
          "controls": {
            "yaw": 0.0,
            "distance": 0.9,
            "height": -0.53
          },
          "picker": {
            "yaw": 0.0,
            "distance": 1.0,
            "height": -0.2
          },
          "hint": {
            "yaw": 0.0,
            "distance": 1.4,
            "height": -0.1
          }
        },
        "restOpacity": 0.6,
        "hoverOpacity": 1.0
      },
      "panels": {
        "about": "Side panels fold to a 60-point tab and unfold on a tap; the elsewhere panel lists elsewhereRows games. During a celebrated moment every panel but the banner and scorebug fades to momentOpacity (reduce motion: folds instead of fading) and comes back momentReturnSeconds after the banner goes.",
        "elsewhereRows": 6,
        "startFolded": {
          "drive": false,
          "trailing": true
        },
        "momentOpacity": 0.0,
        "momentFadeSeconds": 0.35,
        "momentReturnSeconds": 1.0
      },
      "controls": {
        "about": "The bottom panel: play and scrub, speed, replay drive, seat, mute, immersion, leave. It folds to one 60-point pill after autoHideSeconds without a touch and returns on a tap of the pill or a pinch on the field (the reveal catcher, an invisible target this far out).",
        "autoHideSeconds": 8.0,
        "targetPoints": 60.0,
        "revealCatcher": {
          "distance": 14.0,
          "width": 60.0,
          "height": 30.0
        }
      },
      "seatPicker": {
        "about": "A map of the bowl drawn from bowl.shape and presentation.stadium.seats, every seat a 60-point target, previews from each seat's view.",
        "widthPoints": 440.0,
        "heightPoints": 250.0,
        "dotPoints": 60.0,
        "insetPoints": 18.0
      }
