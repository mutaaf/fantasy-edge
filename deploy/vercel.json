// Reference only - NOT the config Vercel reads.
//
// Vercel reads a vercel.json at the repository root and nowhere else, so this
// file has never deployed anything; a copy at the root does. This one is kept
// as the shape to move to once an origin exists to proxy to, because its
// rewrites point /api and /oauth at a container that does not exist yet and
// its placeholder host would fail DNS if it were live.
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "docs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-ME-origin.example.com/api/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "https://REPLACE-ME-origin.example.com/oauth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/oauth/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
