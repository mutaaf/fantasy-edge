<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Records the __SLATE__ slate. Generated by: tools/record_weekend.sh plist __SLATE__
  It starts as soon as it is loaded; the recorder itself waits for the window
  (30 min before the first kickoff) and ends after the last final or 06:00 ET
  Sunday. If the recorder crashes, launchd restarts it and it resumes from what
  is on disk. It does not run again once it has exited cleanly.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mutaaf.saturday.record-weekend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/tools/record_weekend.sh</string>
    <string>__SLATE__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHON</key>
    <string>__PYTHON__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__REPO__/data/capture/__SLATE__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/capture/__SLATE__/launchd.err.log</string>
</dict>
</plist>
